#!/bin/bash
# k4 يشتغل فقط إذا شل الماك شغّال، ويطفي إذا طفى
export HOME=/home/revo USER=revo
export WAYLAND_DISPLAY=wayland-1 XDG_RUNTIME_DIR=/run/user/1000 XDG_SESSION_TYPE=wayland
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
export HYPRLAND_INSTANCE_SIGNATURE=$(ls /run/user/1000/hypr 2>/dev/null | head -1)
unset DISPLAY

MACOS_SHELL="$HOME/.config/quickshell/macos/shell.qml"

while true; do
    if pgrep -f "quickshell.*macos/shell.qml" >/dev/null; then
        if ! pgrep -f "quickshell -p $HOME/.config/quickshell/k4/shell.qml" >/dev/null; then
            setsid "$HOME/.config/quickshell/k4/arrancar" >/dev/null 2>&1 &
        fi
    else
        pkill -f "quickshell -p $HOME/.config/quickshell/k4/shell.qml"
    fi
    sleep 5
done
