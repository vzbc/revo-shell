#!/bin/bash
# k4 يشتغل فقط إذا شل الماك شغّال، ويطفي إذا طفى
RID="$(id -u)"
export HOME="${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
export USER="${USER:-$(id -un)}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$RID}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_SESSION_TYPE=wayland
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export HYPRLAND_INSTANCE_SIGNATURE=$(ls "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)
unset DISPLAY

MACOS_SHELL="$HOME/.config/quickshell/macos/shell.qml"

while true; do
    if pgrep -f "quickshell.*macos/shell.qml" >/dev/null; then
        if ! pgrep -f "quickshell -p $HOME/.config/quickshell/k4/shell.qml" >/dev/null; then
            setsid "$HOME/.config/quickshell/k4/arrancar" >/dev/null 2>&1 &
        fi
    else
        pkill -f "quickshell -p $HOME/.config/quickshell/k4/shell.qml"
    fi
    sleep 5
done
