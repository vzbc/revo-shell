// Ryoku shell — dot entry for the DotsBrowser (Super+B)
//
// Ryoku is NOT a single shell.qml: it is a set of Quickshell components
// (frame bars, launcher, overview, widgets, visualizer) supervised by the
// `ryoku-shell` daemon from its repo at ~/.local/src/ryoku-arch.
//
// Do NOT launch this file directly. Switch to it via Super+B (DotsBrowser)
// or manually:
//   ~/.config/quickshell/ryoku/launch.sh      # start
//   pkill -f "ryoku/shell/ipc/ryoku-shell"    # stop

ShellRoot {}
