+/* ---------------- Finder-style sidebar ----------------
+ * Adds the rows Finder shows that stock nautilus lacks (Shared, Applications,
+ * iCloud Drive, AirDrop, Tags), swaps in authentic SF Symbols / macOS folder
+ * art, and hides the rows Finder keeps out of its sidebar. */
+
+#define FINDER_ICON_DIR "/home/revo/.local/share/nautui/icons/side/"
+
+static GtkWidget *
+finder_row_image (GtkWidget *row)
+{
+    GtkWidget *found = NULL;
+    GQueue queue = G_QUEUE_INIT;
+
+    g_queue_push_tail (&queue, row);
+    while (queue.length > 0)
+    {
+        GtkWidget *w = g_queue_pop_head (&queue);
+
+        if (GTK_IS_IMAGE (w))
+        {
+            found = w;
+            break;
+        }
+
+        for (GtkWidget *c = gtk_widget_get_first_child (w);
+             c != NULL;
+             c = gtk_widget_get_next_sibling (c))
+        {
+            g_queue_push_tail (&queue, c);
+        }
+    }
+
+    return found;
+}
+
+static void
+finder_set_icon_full (GtkWidget *row, const char *file_name, int pixel_size)
+{
+    g_autofree char *path = g_strdup_printf ("%s%s", FINDER_ICON_DIR, file_name);
+    GtkWidget *image;
+
+    if (!g_file_test (path, G_FILE_TEST_EXISTS))
+    {
+        return;
+    }
+
+    image = finder_row_image (row);
+    if (image != NULL)
+    {
+        gtk_image_set_from_file (GTK_IMAGE (image), path);
+
+        if (pixel_size > 0)
+        {
+            gtk_image_set_pixel_size (GTK_IMAGE (image), pixel_size);
+        }
+    }
+}
+
+static void
+finder_set_icon (GtkWidget *row, const char *file_name)
+{
+    finder_set_icon_full (row, file_name, 16);
+}
+
+static const char *
+finder_icon_for_label (const char *label)
+{
+    if (g_strcmp0 (label, "Shared") == 0)
+        return "sf-person.2.fill.svg";
+
+    if (g_strcmp0 (label, "Recents") == 0)
+        return "sf-clock.svg";
+
+    if (g_strcmp0 (label, "Favorites") == 0)
+        return "stock_bookmark.svg";
+
+    if (g_strcmp0 (label, "Applications") == 0)
+        return "applications.svg";
+
+    if (g_strcmp0 (label, "Home Folder") == 0)
+        return "home.svg";
+
+    if (g_strcmp0 (label, "Documents") == 0)
+        return "documents.svg";
+
+    if (g_strcmp0 (label, "Music") == 0)
+        return "music.svg";
+
+    if (g_strcmp0 (label, "Pictures") == 0)
+        return "pictures.svg";
+
+    if (g_strcmp0 (label, "Videos") == 0)
+        return "videos.svg";
+
+    if (g_strcmp0 (label, "Downloads") == 0)
+        return "downloads.svg";
+
+    if (g_strcmp0 (label, "iCloud Drive") == 0)
+        return "icloud.svg";
+
+    if (g_strcmp0 (label, "AirDrop") == 0)
+        return "sf-airdrop.svg";
+
+    return NULL;
+}
+
+static void
+finder_finalize_sidebar (NautilusSidebar *sidebar)
+{
+    static const struct
+    {
+        const char *label;
+        const char *icon;
+    } tags[] =
+    {
+        { "Red", "tag-red.svg" },
+        { "Orange", "tag-orange.svg" },
+        { "Yellow", "tag-yellow.svg" },
+        { "Green", "tag-green.svg" },
+        { "Blue", "tag-blue.svg" },
+        { "Purple", "tag-purple.svg" },
+        { "Gray", "tag-gray.svg" },
+    };
+    g_autofree char *icloud_path = NULL;
+    GtkWidget *row;
+
+    /* Hide rows Finder doesn't show, swap in Finder icons for the rest */
+    for (GtkWidget *child = gtk_widget_get_first_child (GTK_WIDGET (sidebar->list_box));
+         child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        g_autofree char *label = NULL;
+        const char *icon;
+
+        if (!GTK_IS_LIST_BOX_ROW (child))
+        {
+            continue;
+        }
+
+        g_object_get (child, "label", &label, NULL);
+        if (label == NULL)
+        {
+            continue;
+        }
+
+        if (g_strcmp0 (label, "Desktop") == 0 ||
+            g_strcmp0 (label, "Network") == 0 ||
+            g_strcmp0 (label, "Trash") == 0)
+        {
+            gtk_widget_set_visible (child, FALSE);
+            continue;
+        }
+
+        icon = finder_icon_for_label (label);
+        if (icon != NULL)
+        {
+            finder_set_icon (child, icon);
+        }
+    }
+
+    /* iCloud Drive: local stand-in folder so the row is actually usable */
+    icloud_path = g_build_filename (g_get_home_dir (), "iCloud Drive", NULL);
+    if (g_file_test (icloud_path, G_FILE_TEST_IS_DIR) ||
+        g_mkdir_with_parents (icloud_path, 0755) == 0)
+    {
+        g_autofree char *uri = g_filename_to_uri (icloud_path, NULL, NULL);
+
+        row = add_place (sidebar, NAUTILUS_SIDEBAR_ROW_BUILT_IN,
+                         NAUTILUS_SIDEBAR_SECTION_MOUNTS,
+                         "iCloud Drive", NULL, NULL, uri,
+                         NULL, NULL, NULL, NULL, 0,
+                         "iCloud Drive");
+        finder_set_icon (row, "icloud.svg");
+    }
+
+    /* AirDrop: shown like Finder; click is a no-op (no protocol on Linux) */
+    row = add_place (sidebar, NAUTILUS_SIDEBAR_ROW_BUILT_IN,
+                     NAUTILUS_SIDEBAR_SECTION_MOUNTS,
+                     "AirDrop", NULL, NULL, NULL,
+                     NULL, NULL, NULL, NULL, 2,
+                     "AirDrop");
+    finder_set_icon (row, "sf-airdrop.svg");
+
+    for (gsize i = 0; i < G_N_ELEMENTS (tags); i++)
+    {
+        row = add_place (sidebar, NAUTILUS_SIDEBAR_ROW_BUILT_IN,
+                         NAUTILUS_SIDEBAR_SECTION_TAGS,
+                         tags[i].label, NULL, NULL, NULL,
+                         NULL, NULL, NULL, NULL, (int) i,
+                         tags[i].label);
+        finder_set_icon (row, tags[i].icon);
+    }
+}
