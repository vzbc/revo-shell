+    case NAUTILUS_SIDEBAR_SECTION_BOOKMARKS:
+        return "Favorites";
+
+    case NAUTILUS_SIDEBAR_SECTION_CLOUD:
+        return "iCloud";
+
+    case NAUTILUS_SIDEBAR_SECTION_MOUNTS:
+        return "Locations";
+
+    case NAUTILUS_SIDEBAR_SECTION_TAGS:
+        return "Tags";
+
+    default:
+        return NULL;
+    }
+}
