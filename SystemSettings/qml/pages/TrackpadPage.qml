import QtQuick
import ".."

// Trackpad (macOS 27, TrackpadExtension.appex): three tabs, the gesture movie
// on top (Apple's own Trackpad.mov, one clip per chapter) follows the row under
// the pointer. Settings: userconfig input.* (applied live by the shell's
// SettingsBridge) and trackpad.* (gestures → ~/.config/hypr/configs/gestures.lua).
Column {
    id: page

    property string pageId: "trackpad"
    property string accountName: ""
    property string accountEmail: ""
    signal navigate(string pageId)

    readonly property var bumpU: Shell.userCfg
    property int rev: 0
    function ug(k, d) { bumpU; rev; return Shell.uget(k, d) }
    function us(k, v) { Shell.uset(k, v); rev++ }

    width: parent ? parent.width : 640
    spacing: 14

    property int tab: 0
    property string clip: ""
    readonly property bool natural: ug("input.touchpadNatural", true) === true

    function defaultClip() {
        return tab === 0 ? "TapToClick" : tab === 1 ? (natural ? "Scroll-Natural" : "Scroll") : "SwipeBetweenPages-2F" + (natural ? "-Natural" : "")
    }
    onTabChanged: clip = defaultClip()
    Component.onCompleted: clip = defaultClip()

    // --------------------------------------------------- gestures → Hyprland
    function writeGestures() {
        const L = ["-- Trackpad gestures. Generated by System Settings › Trackpad (applies at next login).",
                   "local H = os.getenv(\"HOME\") or \"\"",
                   "local QS = \"qs ipc -p \" .. H .. \"/.config/quickshell/macos call \"",
                   "local function run(c) return function() hl.dispatch(hl.dsp.exec_cmd(c)) end end"]
        const fs = String(ug("trackpad.fullScreenApps", "Swipe Left or Right with Three Fingers"))
        if (fs.indexOf("Three") >= 0) L.push("hl.gesture({ fingers = 3, direction = \"horizontal\", action = \"workspace\" })")
        if (fs.indexOf("Four") >= 0) L.push("hl.gesture({ fingers = 4, direction = \"horizontal\", action = \"workspace\" })")
        if (ug("trackpad.apps", true) === true) L.push("hl.gesture({ fingers = 4, direction = \"pinchin\", action = run(QS .. \"launchpad toggle\") })")
        if (ug("trackpad.showDesktop", true) === true) L.push("hl.gesture({ fingers = 4, direction = \"pinchout\", action = run(\"bash \" .. H .. \"/.config/hypr/scripts/show_desktop.sh\") })")
        Shell.writeFile(HOME_DIR + "/.config/hypr/configs/gestures.lua", L.join("\n") + "\n")
    }
    function setG(k, v) { us(k, v); writeGestures() }

    // -------------------------------------------------------------- pieces
    component Row2: DetailRow {
        id: r
        property string clipName: ""
        HoverHandler { onHoveredChanged: if (hovered && r.clipName) page.clip = r.clipName }
    }

    Item { width: 1; height: 4 }

    MacSegmented {
        anchors.horizontalCenter: parent.horizontalCenter
        options: ["Point & Click", "Scroll & Zoom", "More Gestures"]
        currentIndex: page.tab
        onActivated: (i) => page.tab = i
    }

    // gesture movie (920×282 @2x), transparent left half shows the trackpad
    Item {
        x: Theme.cardMargin
        width: parent.width - 2 * Theme.cardMargin
        height: Math.round(width * 282 / 920)
        AnimatedImage {
            anchors.fill: parent
            source: page.clip ? "qrc:/media/trackpad/" + page.clip + (Theme.dark ? "-dark" : "-light") + ".webp" : ""
            fillMode: Image.PreserveAspectFit
            smooth: true
            mipmap: true
            playing: true
        }
    }

    // ============================ Point & Click ============================
    GroupCard {
        visible: page.tab === 0
        DetailRow {
            title: "Tracking speed"
            isSlider: true
            sliderMinLabel: "Slow"
            sliderMaxLabel: "Fast"
            sliderValue: (Number(page.ug("input.touchpadSpeed", 0)) + 1) / 2
            onMoved: (v) => page.us("input.touchpadSpeed", Math.round((v * 2 - 1) * 20) / 20)
        }
        DetailRow {
            separator: true
            title: "Click"
            pickerOptions: ["Light", "Medium", "Firm"]
            value: String(page.ug("trackpad.click", "Medium"))
            onPicked: (v) => page.us("trackpad.click", v)
        }
        Row2 {
            separator: true
            title: "Force Click and haptic feedback"
            subtitle: "Click then press firmly for Quick Look, Look up, and variable speed media controls."
            showSwitch: true
            switchOn: page.ug("trackpad.forceClick", true) === true
            onToggled: (c) => page.us("trackpad.forceClick", c)
            clipName: "LookUp_DataDetector-1F"
        }
        Row2 {
            separator: true
            title: "Look up & data detectors"
            pickerOptions: ["Force Click with One Finger", "Tap with Three Fingers", "Off"]
            value: String(page.ug("trackpad.lookUp", "Force Click with One Finger"))
            onPicked: (v) => page.us("trackpad.lookUp", v)
            clipName: value === "Tap with Three Fingers" ? "LookUp_DataDetector-3F" : "LookUp_DataDetector-1F"
        }
        Row2 {
            separator: true
            title: "Secondary click"
            pickerOptions: ["Click or Tap with Two Fingers", "Click in Bottom Right Corner", "Click in Bottom Left Corner", "Off"]
            value: String(page.ug("input.touchpadSecondary", "Click or Tap with Two Fingers"))
            onPicked: (v) => page.us("input.touchpadSecondary", v)
            clipName: value === "Click in Bottom Right Corner" ? "SecondaryClick-1F-R"
                    : value === "Click in Bottom Left Corner" ? "SecondaryClick-1F-L" : "SecondaryClick-2F"
        }
        Row2 {
            separator: true
            title: "Tap to click"
            subtitle: "Tap with one finger"
            showSwitch: true
            switchOn: page.ug("input.tapToClick", true) === true
            onToggled: (c) => page.us("input.tapToClick", c)
            clipName: "TapToClick"
        }
    }

    // ============================ Scroll & Zoom ============================
    GroupCard {
        visible: page.tab === 1
        Row2 {
            title: "Natural scrolling"
            subtitle: "Content tracks finger movement"
            showSwitch: true
            switchOn: page.natural
            onToggled: (c) => { page.us("input.touchpadNatural", c); page.clip = c ? "Scroll-Natural" : "Scroll" }
            clipName: page.natural ? "Scroll-Natural" : "Scroll"
        }
        Row2 {
            separator: true
            title: "Zoom in or out"
            subtitle: "Pinch with two fingers"
            showSwitch: true
            switchOn: page.ug("trackpad.zoom", true) === true
            onToggled: (c) => page.us("trackpad.zoom", c)
            clipName: "ZoomIn_Out"
        }
        Row2 {
            separator: true
            title: "Smart zoom"
            subtitle: "Double-tap with two fingers"
            showSwitch: true
            switchOn: page.ug("trackpad.smartZoom", false) === true
            onToggled: (c) => page.us("trackpad.smartZoom", c)
            clipName: "SmartZoom"
        }
        Row2 {
            separator: true
            title: "Rotate"
            subtitle: "Rotate with two fingers"
            showSwitch: true
            switchOn: page.ug("trackpad.rotate", true) === true
            onToggled: (c) => page.us("trackpad.rotate", c)
            clipName: "Rotate"
        }
    }

    // ============================ More Gestures ============================
    GroupCard {
        visible: page.tab === 2
        Row2 {
            title: "Swipe between pages"
            pickerOptions: ["Scroll Left or Right with Two Fingers", "Swipe with Three Fingers", "Swipe with Two or Three Fingers", "Off"]
            value: String(page.ug("trackpad.swipePages", "Scroll Left or Right with Two Fingers"))
            onPicked: (v) => page.us("trackpad.swipePages", v)
            clipName: value === "Swipe with Three Fingers" ? "SwipeBetweenPages-3F" : "SwipeBetweenPages-2F" + (page.natural ? "-Natural" : "")
        }
        Row2 {
            separator: true
            title: "Swipe between full-screen applications"
            pickerOptions: ["Swipe Left or Right with Three Fingers", "Swipe Left or Right with Four Fingers", "Off"]
            value: String(page.ug("trackpad.fullScreenApps", "Swipe Left or Right with Three Fingers"))
            onPicked: (v) => page.setG("trackpad.fullScreenApps", v)
            clipName: (value.indexOf("Four") >= 0 ? "SwipeBetweenFullScreen-4F" : "SwipeBetweenFullScreen-3F") + (page.natural ? "-Natural" : "")
        }
        Row2 {
            separator: true
            title: "Notification Center"
            subtitle: "Swipe left from the right edge with two fingers"
            showSwitch: true
            switchOn: page.ug("trackpad.notificationCenter", true) === true
            onToggled: (c) => page.us("trackpad.notificationCenter", c)
            clipName: "NotificationCenter"
        }
        Row2 {
            separator: true
            title: "Mission Control"
            pickerOptions: ["Swipe Up with Three Fingers", "Swipe Up with Four Fingers", "Off"]
            value: String(page.ug("trackpad.missionControl", "Swipe Up with Three Fingers"))
            onPicked: (v) => page.us("trackpad.missionControl", v)
            clipName: value.indexOf("Four") >= 0 ? "MissionControl-4F" : "MissionControl-3F"
        }
        Row2 {
            separator: true
            title: "App Exposé"
            pickerOptions: ["Swipe Down with Three Fingers", "Swipe Down with Four Fingers", "Off"]
            value: String(page.ug("trackpad.appExpose", "Off"))
            onPicked: (v) => page.us("trackpad.appExpose", v)
            clipName: value.indexOf("Four") >= 0 ? "Expose-4F" : "Expose-3F"
        }
        Row2 {
            separator: true
            title: "Apps"
            subtitle: "Pinch with thumb and three fingers"
            showSwitch: true
            switchOn: page.ug("trackpad.apps", true) === true
            onToggled: (c) => page.setG("trackpad.apps", c)
            clipName: "Launchpad"
        }
        Row2 {
            separator: true
            title: "Show Desktop"
            subtitle: "Spread with thumb and three fingers"
            showSwitch: true
            switchOn: page.ug("trackpad.showDesktop", true) === true
            onToggled: (c) => page.setG("trackpad.showDesktop", c)
            clipName: "ShowDesktop"
        }
    }

    Row {
        anchors.right: parent.right
        anchors.rightMargin: Theme.cardMargin
        spacing: 10
        MacButton {
            text: "Set Up Bluetooth Trackpad…"
            onClicked: page.navigate("bluetooth")
        }
        HelpCircle { anchors.verticalCenter: parent.verticalCenter }
    }

    Item { width: 1; height: 4 }
}
